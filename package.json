{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{js,ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests yet\" && exit 0",
    "check": "npm run lint && npm run format:check && npm run type-check",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.16.2",
    "@react-email/render": "^1.3.1",
    "@sentry/nextjs": "^10.15.0",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "@vercel/analytics": "^1.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "gsap": "^3.13.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "^16.0.7",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "resend": "^6.1.0",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
